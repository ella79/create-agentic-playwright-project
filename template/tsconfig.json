{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@pageObjects": ["./utils/pageObjects/index.ts"],
      "@pageObjects/*": ["./utils/pageObjects/*"],
      "@fixtures/*": ["./utils/fixtures/*"],
      "@url": ["./utils/url.ts"]
    }
  },
  "include": ["utils", "tests", "evals", "agent", "playwright.config.ts"]
}
